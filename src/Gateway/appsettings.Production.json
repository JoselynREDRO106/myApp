{
  "Serilog": {
    "MinimumLevel": "Information",
    "SyslogUrl": "localhost",
    "SyslogPort": "6514",
    "SyslogAppName": "gateway",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4} {ProcessId} --- [{ThreadId,3}] {LoggerName,-40} : {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "app.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4} {ProcessId} --- [{ThreadId,3}] {LoggerName,-40} : {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10240,
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90
        }
      }
    ]
  },
  "EntityFramework": {
    "DataSource": ":memory:"
  },
  "Security": {
    "EnforceHttps": true,
    "Email": {
      "From": "noreply@gateway.com",
      "BaseUrl": "https://gateway.com",
      "Smtp": {
        "Host": "smtp.gateway.com",
        "Port": 587,
        "Username": "",
        "Password": "",
        "UseSsl": true
      }
    }
  }
}
