{
  "Serilog": {
    "MinimumLevel": "Information",
    "Override": {
      "Default": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "SyslogUrl": "localhost",
    "SyslogPort": "6514",
    "SyslogAppName": "gateway",
    "Enrich": ["FromLogContext", "WithProcessId", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "EntityFramework": {
    "DataSource": ":memory:"
  },
  "Consul": {
    "Host": "http://localhost:8500"
  },
  "Security": {
    "Authentication": {
      "Jwt": {
        "Base64Secret": "ZTIzNzliZDYwNDJhZGIwZTdlOTEwYzlhMTBhZGIwY2YzYjUzMzkyYTg1MTcxZjcwYzk5NmY1NjU4NDljMjJmMjNiYzg0MWQ5ZGU5ZmE0NzE1Y2M5YTk2ZjQ3OGMwNTM1YzUwMw==",
        "TokenValidityInSeconds": 86400,
        "TokenValidityInSecondsForRememberMe": 2592000
      }
    },
    "Cors": {
      "AllowedOrigins": "*",
      "AllowedMethods": "*",
      "AllowedHeaders": "*",
      "ExposedHeaders": "Authorization,Link,X-Total-Count,X-Pagination",
      "AllowCredentials": true,
      "MaxAge": 1800
    }
  },
  "RibbonInfo": {
    "display-ribbon-on-profiles": "dev"
  }
}
