{
  "Serilog": {
    "MinimumLevel": "Information",
    "Override": {
      "Default": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "SyslogUrl": "localhost",
    "SyslogPort": "6514",
    "SyslogAppName": "myApp",
    "Enrich": ["FromLogContext", "WithProcessId", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "EntityFramework": {
    "DataSource": ":memory:"
  },
  "Security": {
    "Authentication": {
      "Jwt": {
        "Base64Secret": "OTlkNmI0NTFmZmIzOGU0MzZhNTEyMDRkZmNkYzFhOWI0YzYzZDU3YzJkMGI3NWIyMzZlY2M2ZTAzMWIwNThhY2M1YWI3Y2QwMjI2YmM4MmM1NGUxMjYyYWM2NjQ2NjMxYzVlYw==",
        "TokenValidityInSeconds": 86400,
        "TokenValidityInSecondsForRememberMe": 2592000
      }
    },
    "Cors": {
      "AllowedOrigins": "*",
      "AllowedMethods": "*",
      "AllowedHeaders": "*",
      "ExposedHeaders": "Authorization,Link,X-Total-Count,X-Pagination",
      "AllowCredentials": true,
      "MaxAge": 1800
    }
  },
  "RibbonInfo": {
    "display-ribbon-on-profiles": "dev"
  }
}
